# =============================================================
# Nextcloud AIO - Local Instance Configuration
# =============================================================
# Copy this file to .env before running:
#   cp .env.local .env
# Then fill in the TODO fields below.
# =============================================================

# ---- Required secrets (change all of these!) ---------------
DATABASE_PASSWORD=changeme_db_password          # TODO! Use a strong unique password (no @ or :)
FULLTEXTSEARCH_PASSWORD=changeme_fts_password   # TODO! Use a strong unique password
IMAGINARY_SECRET=changeme_imaginary_secret      # TODO! Use a strong unique password
NEXTCLOUD_PASSWORD=changeme_admin_password      # TODO! Admin user password (username: admin)
ONLYOFFICE_SECRET=changeme_oo_secret            # TODO! Use a strong unique password
RECORDING_SECRET=changeme_rec_secret            # TODO! Use a strong unique password
REDIS_PASSWORD=changeme_redis_password          # TODO! Use a strong unique password
SIGNALING_SECRET=changeme_signal_secret         # TODO! Use a strong unique password
TALK_INTERNAL_SECRET=changeme_talk_secret       # TODO! Use a strong unique password
TURN_SECRET=changeme_turn_secret                # TODO! Use a strong unique password
WHITEBOARD_SECRET=changeme_wb_secret            # TODO! Use a strong unique password

# ---- Domain ------------------------------------------------
# For local setup, use one of these approaches:
#   Option A: Add "127.0.0.1 nextcloud.local" to /etc/hosts and use nextcloud.local
#   Option B: Use your machine's LAN IP (e.g. 192.168.1.x) — requires SKIP_DOMAIN_VALIDATION
NC_DOMAIN=nextcloud.local                       # TODO! Change to your local domain or LAN IP

# ---- Timezone ----------------------------------------------
TIMEZONE=Asia/Riyadh                            # Set to your local timezone

# ---- Optional services (set to "yes" to enable) -----------
CLAMAV_ENABLED="no"
COLLABORA_ENABLED="no"
FULLTEXTSEARCH_ENABLED="no"
IMAGINARY_ENABLED="no"
ONLYOFFICE_ENABLED="no"
TALK_ENABLED="no"
TALK_RECORDING_ENABLED="no"
WHITEBOARD_ENABLED="no"

# ---- Network / Apache settings ----------------------------
# For local use behind a reverse proxy on the same host:
APACHE_IP_BINDING=127.0.0.1
APACHE_PORT=11000
APACHE_MAX_SIZE=17179869184

# ---- Nextcloud tunables -----------------------------------
NEXTCLOUD_DATADIR=nextcloud_aio_nextcloud_data  # Change to a host path (e.g. /mnt/ncdata) if needed
NEXTCLOUD_MOUNT=/mnt/
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M
NEXTCLOUD_STARTUP_APPS="deck twofactor_totp tasks calendar contacts notes"
NEXTCLOUD_ADDITIONAL_APKS=imagemagick
NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS=imagick
NEXTCLOUD_TRUSTED_CACERTS_DIR=/usr/local/share/ca-certificates/my-custom-ca

# ---- Talk -------------------------------------------------
TALK_PORT=3478

# ---- Misc -------------------------------------------------
INSTALL_LATEST_MAJOR=no
REMOVE_DISABLED_APPS=yes
UPDATE_NEXTCLOUD_APPS="no"
FULLTEXTSEARCH_JAVA_OPTIONS="-Xms512M -Xmx512M"
ADDITIONAL_COLLABORA_OPTIONS=['--o:security.seccomp=true']
COLLABORA_DICTIONARIES="de_DE en_GB en_US es_ES fr_FR it nl pt_BR pt_PT ru"
